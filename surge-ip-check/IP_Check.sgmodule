#!name=IP Check
#!desc=IP信息展示(中文)、IP纯净度、下行测速。先在 PROXY/海外节点组选好要测的节点, 再访问 http://ipwho.de/json 或 https://4.ipwho.de/json 查看该节点出口 IP。测速与纯净度默认关闭, 在模块参数里改成 开启。
#!author=unknowntokyo(Egern 原版), Surge 移植版
#!system=ios

[Rule]
DOMAIN,speed.cloudflare.com,PROXY
DOMAIN-SUFFIX,ippure.com,PROXY
DOMAIN-SUFFIX,ipwho.de,PROXY

[Script]
IP Check = type=http-response,pattern=^https?://(?:4\.)?ipwho\.de(?::\d+)?(?:[/?#]|$),script-path=https://raw.githubusercontent.com/yuj940212-sketch/gate/main/surge-ip-check/IP_Check.js,requires-body=true,timeout=8,argument=POLICY=PROXY&SHOW_SPEED_TEST=关闭&SPEED_TEST_PACKET=3&SPEED_TEST_TIMEOUT=5&SHOW_IPPURE=关闭

[MITM]
hostname = %APPEND% 4.ipwho.de, ipwho.de

[Panel]
IP Check = script-path=https://raw.githubusercontent.com/yuj940212-sketch/gate/main/surge-ip-check/IP_Check_Panel.js, update-interval=600
台湾 VPS = script-path=https://raw.githubusercontent.com/yuj940212-sketch/gate/main/surge-ip-check/Taiwan_VPS_Panel.js, update-interval=600
